{
	"private": true,
	"name": "pseuplex",
	"version": "0.2.1",
	"description": "A middleware for the plex server API",
	"type": "module",
	"bin": {
		"pseuplex": "dist/server/main.js"
	},
	"main": "dist/server/index.js",
	"types": "dist/server/index.d.ts",
	"repository": {
		"type": "git",
		"url": "https://github.com/lufinkey/pseuplex.git"
	},
	"scripts": {
		"clean": "rm -rf build dist .react-router node_modules plugindeps pluginexample/node_modules pluginexample/dist pluginexample/package-lock.json",
		"build": "nnpm run webapp-build && npm run server-build --",
		"start": "npm run webapp-build && npm run server-start --",
		"start-dev": "npm run webapp-build && npm run server-start-dev --",
		"prepare": "npm run webapp-typecheck && npm run server-typecheck",
		"server-typecheck": "tsc --project tsconfig.server.json",
		"server-build": "npm run server-typecheck && npm link pseuplex@file:./",
		"server-start": "npm run server-typecheck && node --enable-source-maps dist/server/main.js",
		"server-start-dev": "npm run server-typecheck && node --enable-source-maps --trace-deprecation dist/server/main.js --config=config/config.json --verbose --verbose-traffic",
		"server-debug": "npm run server-typecheck && node --enable-source-maps --inspect dist/server/main.js --config=config/config.json --verbose",
		"webapp-typecheck": "react-router typegen && tsc --project tsconfig.webapp.json",
		"webapp-build": "react-router build",
		"webapp-dev": "react-router dev",
		"webapp-start": "react-router-serve ./build/server/index.js"
	},
	"author": "Luis Finke (luisfinke@gmail.com)",
	"license": "Zlib",
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@mui/material": "^6.4.4",
		"@react-router/node": "^7.1.5",
		"@react-router/serve": "^7.1.5",
		"bowser": "^2.11.0",
		"express": "^5.1.0",
		"express-http-proxy": "https://github.com/lufinkey/express-http-proxy.git",
		"http-proxy": "https://github.com/Jimbly/http-proxy-node16.git",
		"httpolyglot": "^0.1.2",
		"isbot": "^5",
		"letterboxd-retriever": "https://github.com/lufinkey/letterboxd-retriever.git",
		"node-forge": "^1.3.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router": "^7.1.5",
		"sharp": "^0.34.3",
		"winreg": "^1.2.5",
		"xml2js": "^0.6.2"
	},
	"devDependencies": {
		"@react-router/dev": "^7.1.5",
		"@tailwindcss/vite": "^4.0.0",
		"@types/react": "^19.0.1",
		"@types/react-dom": "^19.0.1",
		"@types/express": "^5.0.3",
		"@types/express-http-proxy": "1.6.6",
		"@types/http-proxy": "^1.17.15",
		"@types/node": "^22.16.5",
		"@types/node-forge": "^1.3.11",
		"@types/winreg": "^1.2.36",
		"@types/xml2js": "^0.4.14",
		"react-router-devtools": "^1.1.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.7.2",
		"vite": "^5.4.11",
		"vite-tsconfig-paths": "^5.1.4"
	}
}